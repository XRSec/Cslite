{
  "name": "cslite",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "node web/build.mjs",
    "build:server": "npm run build:web && npm run typecheck",
    "build:scf": "npm run build:web && bash deploy/scf/build-scf.sh",
    "build": "npm run build:server",
    "dev": "npm run build:web && tsx watch server/src/entry-node.ts",
    "dev:worker": "npm run build:web && cd server && wrangler dev",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "npm run build:web && vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.19",
    "hono": "^4.13.22",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "^26.6.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
